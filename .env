# .env

# 数据库（docker-compose 会覆盖这个）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/policy_db
TEST_DATABASE_URL = "postgresql+asyncpg://postgres:postgres@db:5432/policy_db"

# JWT 密钥（生产必须改成随机强密钥！）
SECRET_KEY=super-secret-key-please-change-this-in-production-2026

# 其他
ENVIRONMENT=development